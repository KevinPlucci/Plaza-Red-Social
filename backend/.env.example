# Copiar como .env y completar.

# Cadena de conexión de MongoDB (Atlas o local)
MONGODB_URI=mongodb://127.0.0.1:27017/red-social

# URL pública del backend: con ella se arman las URL de las imágenes guardadas
URL_PUBLICA=http://localhost:3000

# Orígenes del front que pueden llamar a la API (separados por coma)
CORS_ORIGEN=http://localhost:4200

# Clave con la que se firman los tokens JWT. En producción, un texto largo y aleatorio.
JWT_SECRETO=cambiar-por-un-secreto-largo-y-aleatorio
